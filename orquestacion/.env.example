# Plantilla del entorno local integrado (docker compose). Copia este archivo a orquestacion/.env y completa los
# valores marcados como obligatorios. orquestacion/.env NO se versiona (.gitignore: .env) y no debe compartirse.
# Las contraseñas solo valen para este entorno local: no reutilices las de ningún despliegue real.
# Docker Compose interpreta "$" en los valores: si una contraseña lleva "$", escríbela entre comillas simples
# (CLAVE='a$b'); sin comillas se recortaría en silencio.

# --- Ubicación de los otros dos repositorios (relativa a esta carpeta o absoluta, con / también en Windows) ---
SECURITY_MODULE_DIR=../../Security-Module
EVALUATION_QUERY_API_DIR=../../evaluation-query-api

# --- PostgreSQL ---
POSTGRES_DB=db_scoring
POSTGRES_ADMIN_USER=postgres
# Obligatorio. Administrador de la base: solo lo usan los pasos de preparación, nunca las APIs.
POSTGRES_ADMIN_PASSWORD=
# Puerto en el equipo (solo 127.0.0.1) para conectarse con psql/DBeaver.
POSTGRES_HOST_PORT=5433

# Rol de scoring-api y auth-api (propietario de public, sin superusuario). Contraseña obligatoria.
CREDITICIO_DB_USER=crediticio_app
CREDITICIO_DB_PASSWORD=

# Roles de evaluation-query-api (los crea su script oficial 01-preparar-antes-de-migrar.sql). Contraseñas obligatorias.
CONSULTA_APP_USER=consulta_app
CONSULTA_APP_PASSWORD=
CONSULTA_MIGRADOR_USER=consulta_migrador
CONSULTA_MIGRADOR_PASSWORD=

# --- JWT de usuario (auth-api emite; scoring-api y evaluation-query-api validan el mismo emisor) ---
JWT_ISSUER=crediticio-auth
# Máximo 900000 (15 min); auth-api no arranca si se supera.
JWT_EXPIRATION_MS=900000

# --- Primer administrador de auth-api (solo se usa si no existe ningún ADMINISTRADOR_RIESGO) ---
# Necesario para iniciar sesión y obtener tokens en el entorno local. Contraseña de al menos 12 caracteres.
INIT_ADMIN_EMAIL=
INIT_ADMIN_PASSWORD=
INIT_ADMIN_NOMBRE=Administrador

# --- Integración ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Saga y proyección scoring-api -> evaluation-query-api (comunicación entre contenedores con token de servicio).
SAGA_HABILITADA=true
SCORING_SERVICE_JWT_KEY_ID=local-scoring-service-v1

# --- Observabilidad (Prometheus y Grafana) ---
# Obligatorio. Contraseña de la cuenta técnica "prometheus-scraper" con la que Prometheus lee /actuator/prometheus
# de las tres APIs (HTTP Basic, independiente de los JWT de usuario).
METRICS_SCRAPER_PASSWORD=
# Obligatorio. Administrador de Grafana (http://localhost:3001).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Puertos publicados en el equipo (solo 127.0.0.1) ---
SCORING_HOST_PORT=8080
AUTH_HOST_PORT=8081
QUERY_HOST_PORT=8082
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
