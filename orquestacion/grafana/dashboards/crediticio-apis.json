        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Rechazos del cliente (4xx) por segundo",
      "description": "401/403 (seguridad), 400/404/409/415 (validación y negocio).",
