    {
      "id": 6,
      "type": "timeseries",
      "title": "Memoria heap de la JVM",
      "description": "Memoria heap en uso por API.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-local"
          },
          "expr": "sum by (job) (jvm_memory_used_bytes{job=~\"$servicio\", area=\"heap\"})",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
