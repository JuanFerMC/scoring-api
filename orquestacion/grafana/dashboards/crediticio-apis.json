    {
      "id": 8,
      "type": "timeseries",
      "title": "Uso de CPU del proceso",
      "description": "Fracción de CPU usada por la JVM de cada API.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "gridPos": {
