    {
      "id": 9,
      "type": "table",
      "title": "Endpoints con más tráfico (últimos 5 min)",
      "description": "Las 15 combinaciones de API, método, ruta y estado con más peticiones por segundo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-local"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-local"
          },
          "format": "table",
          "instant": true,
          "expr": "topk(15, sum by (job, method, uri, status) (rate(http_server_requests_seconds_count{job=~\"$servicio\", uri!~\"/actuator.*\"}[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "peticiones/s",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "job": 0,
              "method": 1,
              "uri": 2,
              "status": 3,
              "Value": 4
            },
            "renameByName": {
              "job": "API",
              "method": "método",
              "uri": "ruta",
              "status": "estado",
              "Value": "peticiones/s"
            }
          }
        }
      ]
    }
